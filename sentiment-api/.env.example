# Environment Variables für Moodlight System
# Kopiere diese Datei zu .env und fülle die Werte aus

# Anthropic API Key (ERFORDERLICH) — Sentiment-Analyse mit Claude Haiku
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# PostgreSQL Passwort
POSTGRES_PASSWORD=your-secure-database-password-here

# Admin-Zugang zum Dashboard
ADMIN_PASSWORD=your-admin-password-here
SECRET_KEY=your-random-flask-session-secret-here

# Firmware-Spiegel: Token, mit dem sich GitHub Actions beim Sync-Endpoint
# ausweist. Muss identisch mit dem Repository-Secret FIRMWARE_SYNC_TOKEN sein.
# Ohne gesetzten Wert ist /api/firmware/sync gesperrt.
FIRMWARE_SYNC_TOKEN=your-random-sync-token-here

# Optional: Andere Einstellungen
# DEFAULT_HEADLINES_PER_SOURCE=1
# REDIS_MAX_MEMORY=256mb
# FIRMWARE_MIRROR_DIR=/data/firmware
# FIRMWARE_GITHUB_REPO=Revisor01/auraos-moodlight
